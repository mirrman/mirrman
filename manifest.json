{
  "name": "Mirrman",
  "description": "An extension help you mirror a Github repo to your own Gitea instence",
  "version": "1.1",
  "manifest_version": 3,
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icon/icon64.png"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  }
}
